<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TaskStack splash theme: dark navy matches the app icon background -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- windowBackground is the splash: full-screen color until Flutter paints -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#1A1A2E</item>
        <item name="android:navigationBarColor">#1A1A2E</item>
    </style>
    <!-- Normal theme after Flutter initialises -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
